{
  "name": "learn-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "wrangler d1 migrations apply learn-lab --local",
    "deploy": "npm run build && wrangler deploy",
    "curriculum:discover": "tsx scripts/discover.ts",
    "curriculum:crawl": "tsx scripts/curriculum.ts crawl",
    "curriculum:parse": "tsx scripts/curriculum.ts parse",
    "curriculum:sync": "tsx scripts/curriculum.ts sync",
    "curriculum:validate": "tsx scripts/curriculum.ts validate",
    "questions:generate": "tsx scripts/questions.ts generate",
    "questions:validate": "tsx scripts/questions.ts validate",
    "db:prepare": "tsx scripts/import-db.ts",
    "db:import": "npm run db:prepare && wrangler d1 execute learn-lab --local --file data/import.sql",
    "db:types": "wrangler types"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "linkedom": "^0.18.13",
    "shiki": "^4.4.3",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.2",
    "cheerio": "^1.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "robots-parser": "^3.0.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "sharp": "^0.35.4"
  }
}
